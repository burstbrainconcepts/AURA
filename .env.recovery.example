# PostgreSQL connection string (use Railway's DATABASE_URL or a managed PostgreSQL URL)
DATABASE_URL=postgresql://aura_user:replace_me@localhost:5432/aura_recovery

# Generate an Ed25519 private key with:
# openssl genpkey -algorithm ED25519 -out aura-command-private.pem
# base64 -w 0 aura-command-private.pem
# Keep the resulting base64 private key only in your server secret manager.
AURA_COMMAND_PRIVATE_KEY_B64=REPLACE_WITH_BASE64_ED25519_PRIVATE_KEY

# Generate a random account token (at least 32 characters) and keep it private.
AURA_BOOTSTRAP_ACCOUNT_ID=account-ephraim
AURA_BOOTSTRAP_ACCOUNT_TOKEN=REPLACE_WITH_LONG_RANDOM_ACCOUNT_TOKEN

PORT=8787
